continuousmeasurementslatex/*.fls
continuousmeasurementslatex/*.log
continuousmeasurementslatex/*.out
continuousmeasurementslatex/*.pdf
continuousmeasurementslatex/*.synctex.gz
continuousmeasurementslatex/*.toc
continuousmeasurementslatex/**/*.aux
continuousmeasurementslatex/**/*.log

